<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Admin | Hotel Transylvania | Orders Management </title>

    <!-- ALL CSS IN ONE PLACE -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin/partials/header.css">
    <link rel="stylesheet" href="/css/admin/order.css">
    <link rel="stylesheet" href="/css/admin/partials/footer.css">
</head>
<body>

    <!-- ADMIN HEADER -->
    <%- include('../partials/admin/header.ejs') %>

    <!-- PAGE HEADER -->
    <section class="page-header">
        <div class="container">
            <div class="page-title-section">
                <div>
                    <h1 class="page-title">
                        <i class="fas fa-shopping-cart"></i>
                        Orders Management
                    </h1>
                    <div class="breadcrumb">
                        <a href="/admin">Dashboard</a>
                        <i class="fas fa-chevron-right"></i>
                        <span>All Orders</span>
                    </div>
                </div>
            </div>

            <!-- ORIGINAL STATS CARDS (Keep these) -->
            <div class="stats-cards">
                <div class="stat-card">
                    <div class="stat-icon total">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <div class="stat-info">
                        <h3> <%= orderAnalytics.allTime || 0 %> </h3>
                        <p>Total Orders</p>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon active">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stat-info">
                        <h3> <%= orderAnalytics?.byStatus?.pending || 0 %> </h3>
                        <p>Pending</p>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon rating">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="stat-info">
                        <h3> <%= orderAnalytics?.byStatus?.completed || 0 %> </h3>
                        <p>Completed</p>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon popular">
                        <i class="fas fa-ban"></i>
                    </div>
                    <div class="stat-info">
                        <h3> <%= orderAnalytics?.byStatus?.cancelled || 0 %> </h3>
                        <p>Cancelled</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- NEW ORDER ANALYTICS SECTION (Add this after stats-cards) -->
    <section class="order-analytics-section">
        <div class="container">
            <div class="analytics-header">
                <h2 class="analytics-title">
                    <i class="fas fa-chart-line"></i>
                    Order Analytics
                </h2>
                <p class="analytics-subtitle">Track your order performance over time</p>
            </div>

            <!-- Daily Analytics Card -->
            <div class="analytics-grid">
                <div class="analytics-card daily-card">
                    <div class="analytics-card-header">
                        <div class="analytics-icon daily-icon">
                            <i class="fas fa-sun"></i>
                        </div>
                        <h3>Daily Orders</h3>
                        <span class="analytics-period">Today vs Yesterday</span>
                    </div>
                    <div class="analytics-card-body">
                        <div class="analytics-comparison">
                            <div class="comparison-item">
                                <span class="comparison-label">Today</span>
                                <span class="comparison-value"><%= orderAnalytics?.daily?.today || 0 %></span>
                            </div>
                            <div class="comparison-divider">
                                <i class="fas fa-arrow-right"></i>
                            </div>
                            <div class="comparison-item">
                                <span class="comparison-label">Yesterday</span>
                                <span class="comparison-value"><%= orderAnalytics?.daily?.yesterday || 0 %></span>
                            </div>
                        </div>
                        <div class="analytics-change <%= orderAnalytics?.daily?.isIncrease ? 'positive' : 'negative' %>">
                            <i class="fas fa-arrow-<%= orderAnalytics?.daily?.isIncrease ? 'up' : 'down' %>"></i>
                            <span><%= Math.abs(orderAnalytics?.daily?.change || 0).toFixed(1) %>% vs yesterday</span>
                        </div>
                    </div>
                </div>

                <!-- Weekly Analytics Card -->
                <div class="analytics-card weekly-card">
                    <div class="analytics-card-header">
                        <div class="analytics-icon weekly-icon">
                            <i class="fas fa-calendar-week"></i>
                        </div>
                        <h3>Weekly Orders</h3>
                        <span class="analytics-period">This Week vs Last Week</span>
                    </div>
                    <div class="analytics-card-body">
                        <div class="analytics-comparison">
                            <div class="comparison-item">
                                <span class="comparison-label">This Week</span>
                                <span class="comparison-value"><%= orderAnalytics?.weekly?.thisWeek || 0 %></span>
                            </div>
                            <div class="comparison-divider">
                                <i class="fas fa-arrow-right"></i>
                            </div>
                            <div class="comparison-item">
                                <span class="comparison-label">Last Week</span>
                                <span class="comparison-value"><%= orderAnalytics?.weekly?.lastWeek || 0 %></span>
                            </div>
                        </div>
                        <div class="analytics-change <%= orderAnalytics?.weekly?.isIncrease ? 'positive' : 'negative' %>">
                            <i class="fas fa-arrow-<%= orderAnalytics?.weekly?.isIncrease ? 'up' : 'down' %>"></i>
                            <span><%= Math.abs(orderAnalytics?.weekly?.change || 0).toFixed(1) %>% vs last week</span>
                        </div>
                    </div>
                </div>

                <!-- Monthly Analytics Card -->
                <div class="analytics-card monthly-card">
                    <div class="analytics-card-header">
                        <div class="analytics-icon monthly-icon">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                        <h3>Monthly Orders</h3>
                        <span class="analytics-period">This Month vs Last Month</span>
                    </div>
                    <div class="analytics-card-body">
                        <div class="analytics-comparison">
                            <div class="comparison-item">
                                <span class="comparison-label">This Month</span>
                                <span class="comparison-value"><%= orderAnalytics?.monthly?.thisMonth || 0 %></span>
                            </div>
                            <div class="comparison-divider">
                                <i class="fas fa-arrow-right"></i>
                            </div>
                            <div class="comparison-item">
                                <span class="comparison-label">Last Month</span>
                                <span class="comparison-value"><%= orderAnalytics?.monthly?.lastMonth || 0 %></span>
                            </div>
                        </div>
                        <div class="analytics-change <%= orderAnalytics?.monthly?.isIncrease ? 'positive' : 'negative' %>">
                            <i class="fas fa-arrow-<%= orderAnalytics?.monthly?.isIncrease ? 'up' : 'down' %>"></i>
                            <span><%= Math.abs(orderAnalytics?.monthly?.change || 0).toFixed(1) %>% vs last month</span>
                        </div>
                    </div>
                </div>

                <!-- Yearly Analytics Card -->
                <div class="analytics-card yearly-card">
                    <div class="analytics-card-header">
                        <div class="analytics-icon yearly-icon">
                            <i class="fas fa-calendar"></i>
                        </div>
                        <h3>Yearly Orders</h3>
                        <span class="analytics-period">This Year vs Last Year</span>
                    </div>
                    <div class="analytics-card-body">
                        <div class="analytics-comparison">
                            <div class="comparison-item">
                                <span class="comparison-label">This Year</span>
                                <span class="comparison-value"><%= orderAnalytics?.yearly?.thisYear || 0 %></span>
                            </div>
                            <div class="comparison-divider">
                                <i class="fas fa-arrow-right"></i>
                            </div>
                            <div class="comparison-item">
                                <span class="comparison-label">Last Year</span>
                                <span class="comparison-value"><%= orderAnalytics?.yearly?.lastYear || 0 %></span>
                            </div>
                        </div>
                        <div class="analytics-change <%= orderAnalytics?.yearly?.isIncrease ? 'positive' : 'negative' %>">
                            <i class="fas fa-arrow-<%= orderAnalytics?.yearly?.isIncrease ? 'up' : 'down' %>"></i>
                            <span><%= Math.abs(orderAnalytics?.yearly?.change || 0).toFixed(1) %>% vs last year</span>
                        </div>
                    </div>
                </div>

                <!-- All Time Card -->
                <div class="analytics-card alltime-card">
                    <div class="analytics-card-header">
                        <div class="analytics-icon alltime-icon">
                            <i class="fas fa-infinity"></i>
                        </div>
                        <h3>All Time Orders</h3>
                        <span class="analytics-period">Total completed orders</span>
                    </div>
                    <div class="analytics-card-body">
                        <div class="alltime-value">
                            <span class="alltime-number"><%= orderAnalytics?.allTime || 0 %></span>
                        </div>
                        <div class="alltime-note">
                            <i class="fas fa-check-circle"></i> Lifetime total
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SEARCH AND FILTERS SECTION (Keep existing) -->
    <!-- SEARCH AND FILTERS SECTION -->
        <section class="filters-bar" id="table">
            <div class="container">
                <form method="GET" action="/admin/orders/#table" class="filters-content">
                    <div class="search-box">
                        <input
                            type="text"
                            name="search"
                            placeholder="Search by food name..."
                            value="<%= searchQuery || '' %>"
                            class="search-input"
                        >
                        <!--<i class="fas fa-search search-icon"></i>-->
                        <% if (searchQuery) { %>
                            <a href="/admin/orders<%= statusFilter ? '?status=' + statusFilter : '' %>/#table" class="clear-btn">
                                <i class="fas fa-times"></i>
                            </a>
                        <% } %>
                    </div>
    
                    <div class="filter-actions">
                        <select name="status" class="filter-select" onchange="this.form.submit()">
                            <option value="">All Orders</option>
                            <option value="pending" <%= statusFilter === 'pending' ? 'selected' : '' %>>Pending</option>
                            <option value="processing" <%= statusFilter === 'processing' ? 'selected' : '' %>>Processing</option>
                            <option value="completed" <%= statusFilter === 'completed' ? 'selected' : '' %>>Completed</option>
                            <option value="cancelled" <%= statusFilter === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                        </select>
    
                        <select name="sort" class="filter-select" onchange="this.form.submit()">
                            <option value="newest" <%= sortBy === 'newest' ? 'selected' : '' %>>Newest First</option>
                            <option value="oldest" <%= sortBy === 'oldest' ? 'selected' : '' %>>Oldest First</option>
                            <option value="price_high" <%= sortBy === 'price_high' ? 'selected' : '' %>>Price: High to Low</option>
                            <option value="price_low" <%= sortBy === 'price_low' ? 'selected' : '' %>>Price: Low to High</option>
                        </select>
    
                        <button type="submit" class="search-btn">
                            <i class="fas fa-search"></i> Search
                            <!--<i class="fas fa-filter"></i> Apply -->
                        </button>
                    </div>
                </form>
    
                <!-- Active Filters -->
                <% if (searchQuery || statusFilter || sortBy !== 'newest') { %>
                    <div class="active-filters">
                        <span>Active filters:</span>
                        <% if (searchQuery) { %>
                            <span class="active-filter">
                                Food: "<%= searchQuery %>"
                                <a href="/admin/orders<%= statusFilter ? '?status=' + statusFilter : '' %><%= sortBy !== 'newest' ? '&sort=' + sortBy : '' %>/#table"
                                   class="remove-filter">
                                    <!--×-->
                                    <i class="fas fa-remove"></i>
                                </a>
                            </span>
                        <% } %>
                        <% if (statusFilter) { %>
                            <span class="active-filter">
                                Status: <%= statusFilter %>
                                <a href="/admin/orders<%= searchQuery ? '?search=' + searchQuery : '' %><%= sortBy !== 'newest' ? '&sort=' + sortBy : '' %>/#table"
                                   class="remove-filter">
                                    <!--×-->
                                    <i class="fas fa-remove"></i>
                                </a>
                            </span>
                        <% } %>
                        <% if (sortBy && sortBy !== 'newest') { %>
                            <span class="active-filter">
                                Sort: <%= sortBy === 'oldest' ? 'Oldest First' : (sortBy === 'price_high' ? 'Price High' : 'Price Low') %>
                                <a href="/admin/orders<%= searchQuery ? '?search=' + searchQuery : '' %><%= statusFilter ? '&status=' + statusFilter : '' %>/#table"
                                   class="remove-filter">
                                    <i class="fas fa-remove"></i>
                                </a>
                            </span>
                        <% } %>
                        <a href="/admin/orders/#table" style="margin-left: auto; color: #FF6B6B; font-size: 13px;">
                            Clear all
                        </a>
                    </div>
                <% } %>
            </div>
        </section>
    
        <!-- ACTIVE FILTERS SECTION (Add this after filters-bar) -->
        <% if (searchQuery || statusFilter || sortBy !== 'newest') { %>
            <div class="container">
                <div class="active-filters">
                    <div class="active-filters-header">
                        <h4><i class="fas fa-filter"></i> Active Filters</h4>
                        <a href="/admin/orders/#table" class="btn btn-sm btn-secondary" style="background: #ff5252;">
                            <i class="fas fa-times"></i> Clear All
                        </a>
                    </div>
                    <div class="active-filters-list">
                        <% if (searchQuery) { %>
                            <span class="active-filter-badge">
                                Food Search: "<%= searchQuery %>"
                                <a href="/admin/orders<%= statusFilter ? '?status=' + statusFilter : '' %><%= sortBy !== 'newest' ? '&sort=' + sortBy : '' %>/#table"
                                   class="remove-filter">
                                    <i class="fas fa-times"></i>
                                </a>
                            </span>
                        <% } %>
    
                        <% if (statusFilter) { %>
                            <span class="active-filter-badge">
                                Status: <%= statusFilter.charAt(0).toUpperCase() + statusFilter.slice(1) %>
                                <a href="/admin/orders<%= searchQuery ? '?search=' + searchQuery : '' %><%= sortBy !== 'newest' ? '&sort=' + sortBy : '' %>/#table"
                                   class="remove-filter">
                                    <i class="fas fa-times"></i>
                                </a>
                            </span>
                        <% } %>
    
                        <% if (sortBy && sortBy !== 'newest') { %>
                            <% const sortText = {
                                'oldest': 'Oldest First',
                                'price_high': 'Price: High to Low',
                                'price_low': 'Price: Low to High'
                            }[sortBy] %>
    
                            <% if (sortText) { %>
                                <span class="active-filter-badge">
                                    Sort: <%= sortText %>
                                    <a href="/admin/orders<%= searchQuery ? '?search=' + searchQuery : '' %><%= statusFilter ? '&status=' + statusFilter : '' %>/#table"
                                       class="remove-filter">
                                        <i class="fas fa-times"></i>
                                    </a>
                                </span>
                            <% } %>
                        <% } %>
                    </div>
                </div>
            </div>
        <% } %>
    
        <!-- ORDERS TABLE -->
        <section class="orders-table-container">
            <div class="container">
                <div class="table-header">
                    <h3>
                        <i class="fas fa-list"></i>
                        Recent Orders
                        <% if (searchQuery) { %>
                            <span style="font-size: 14px; margin-left: 10px; opacity: 0.8;">
                                (Search: "<%= searchQuery %>")
                            </span>
                        <% } %>
                    </h3>
                    <div class="table-actions">
                        <!--<button class="table-btn" onclick="exportOrders()">
                            <i class="fas fa-download"></i> Export
                        </button>-->
                        <button class="table-btn" onclick="printOrders()">
                            <i class="fas fa-print"></i> Print
                        </button>
                    </div>
                </div>
    
                <% if (orders.length > 0) { %>
                    <div class="table-responsive">
                        <table class="orders-table">
                            <thead>
                                <tr>
                                    <th>Order Details</th>
                                    <th>Food Item</th> <!-- Changed from Customer -->
                                    <th>Customer</th>
                                    <th>Date</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% orders.forEach(order => { %>
                                    <tr>
                                        <td>
                                            <div class="order-item-cell">
                                                <div class="order-icon">
                                                    <i class="fas fa-shopping-bag"></i>
                                                </div>
                                                <div class="order-details">
                                                    <div class="order-id">#<%= order._id.toString().slice(-6).toUpperCase() %></div>
                                                    <div class="order-items"><%= order.itemCount || 1 %> item(s)</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="food-item-cell"> <!-- Food details -->
                                                <div class="food-details">
                                                    <div class="food-name">
                                                        <%= order.foodName || 'Food Item' %>
                                                    </div>
                                                    <div class="food-info">
                                                        <% if (order.foodCategory) { %>
                                                            <span class="food-category">
                                                                <%= order.foodCategory %>
                                                            </span>
                                                        <% } %>
                                                        <% if (order.foodPrice) { %>
                                                            <span class="food-price">
                                                                $<%= order.foodPrice %>
                                                            </span>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="customer-cell">
                                                <div class="customer-name">
                                                    <%= order.customerName || 'Customer ' + order.orderedBy.slice(0, 4) %>
                                                </div>
                                                <div class="customer-contact">
                                                    <i class="fas fa-user"></i> <%= order.orderedBy.slice(0, 8) %>...
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="date-cell">
                                                <div class="order-date">
                                                    <%= new Date(order.createdAt).toLocaleDateString('en-US', {
                                                        month: 'short',
                                                        day: 'numeric',
                                                        year: 'numeric'
                                                    }) %>
                                                </div>
                                                <div class="order-time">
                                                    <%= new Date(order.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="price-cell">$<%= order.totalAmount || '0.00' %></div>
                                        </td>
                                        <td>
                                            <span class="status-badge status-<%= order.status || 'pending' %>">
                                                <i class="fas fa-circle"></i>
                                                <%= (order.status || 'pending').charAt(0).toUpperCase() + (order.status || 'pending').slice(1) %>
                                            </span>
                                        </td>
                                        <td>
                                            <div class="actions-cell">
                                                <a href="/admin/orders/<%= order._id %>/#table" class="action-btn action-view" title="View Order">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <button class="action-btn action-edit" title="Edit Order" onclick="editOrder('<%= order._id %>')">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button class="action-btn action-delete" title="Delete Order" onclick="deleteOrder('<%= order._id %>')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="fas fa-shopping-cart"></i>
                        </div>
                        <h4>No Orders Found</h4>
                        <% if (searchQuery) { %>
                            <p>No orders found for food name "<%= searchQuery %>"</p>
                            <div style="margin-top: 20px;">
                                <a href="/admin/orders<%= statusFilter ? '?status=' + statusFilter : '' %>/#table" class="btn btn-secondary">
                                    <i class="fas fa-times"></i> Clear Search
                                </a>
                            </div>
                        <% } else if (statusFilter) { %>
                            <p>No orders found with status "<%= statusFilter %>"</p>
                            <div style="margin-top: 20px;">
                                <a href="/admin/orders/#table" class="btn btn-secondary">
                                    <i class="fas fa-times"></i> Clear Filter
                                </a>
                            </div>
                        <% } else { %>
                            <p>There are no orders yet. Start by adding your first order!</p>
                            <div style="margin-top: 20px;">
                                <a href="/admin/foods" class="btn btn-primary">
                                    <i class="fas fa-utensils"></i> Browse Foods
                                </a>
                            </div>
                        <% } %>
                    </div>
                <% } %>
    
                <!-- PAGINATION (Preserves all filters) -->
                <% if (totalPages > 1) { %>
                    <div class="pagination">
                        <!-- Previous Button -->
                        <% if (currentPage > 1) { %>
                            <a href="/admin/orders?page=<%= currentPage - 1 %><%= searchQuery ? '&search=' + searchQuery : '' %><%= statusFilter ? '&status=' + statusFilter : '' %><%= sortBy ? '&sort=' + sortBy : '' %>/#table"
                               class="pagination-btn">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        <% } else { %>
                            <span class="pagination-btn disabled">
                                <i class="fas fa-chevron-left"></i>
                            </span>
                        <% } %>
    
                        <!-- Page Numbers -->
                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <% if (i === currentPage) { %>
                                <span class="pagination-btn active"><%= i %></span>
                            <% } else if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) { %>
                                <a href="/admin/orders?page=<%= i %><%= searchQuery ? '&search=' + searchQuery : '' %><%= statusFilter ? '&status=' + statusFilter : '' %><%= sortBy ? '&sort=' + sortBy : '' %>/#table"
                                   class="pagination-btn"><%= i %></a>
                            <% } else if (i === currentPage - 3 || i === currentPage + 3) { %>
                                <span class="pagination-ellipsis">...</span>
                            <% } %>
                        <% } %>
    
                        <!-- Next Button -->
                        <% if (currentPage < totalPages) { %>
                            <a href="/admin/orders?page=<%= currentPage + 1 %><%= searchQuery ? '&search=' + searchQuery : '' %><%= statusFilter ? '&status=' + statusFilter : '' %><%= sortBy ? '&sort=' + sortBy : '' %>/#table"
                               class="pagination-btn">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        <% } else { %>
                            <span class="pagination-btn disabled">
                                <i class="fas fa-chevron-right"></i>
                            </span>
                        <% } %>
                    </div>
                <% } %>
    
                <!-- RESULTS SUMMARY -->
                <div class="results-summary">
                    <div class="summary-text">
                        Showing <strong><%= orders.length %></strong> of <strong><%= orderAnalytics.allTime %></strong> orders
                        <% if (searchQuery) { %>
                            for food "<strong><%= searchQuery %></strong>"
                        <% } %>
                        <% if (statusFilter) { %>
                            with status "<strong><%= statusFilter %></strong>"
                        <% } %>
                    </div>
                    <div class="page-info">
                        Page <strong><%= currentPage %></strong> of <strong><%= totalPages %></strong>
                    </div>
                </div>
            </div>
        </section>
        
	<!-- ADMIN FOOTER -->
	<%- include('../partials/admin/footer.ejs') %>
	
  <script src="/js/admin/order.js"></script>
</body>
</html>
