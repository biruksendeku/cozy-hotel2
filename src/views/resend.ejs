<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title> Resend Verification | Hotel Transylvania </title>
  <link rel="stylesheet" href="/css/resend.css">
</head>
<body>
  <div class="container">
    <div class="warning-header">
      <h1>⚠️ Invalid or Expired Verification Link</h1>
      <p>This verification link is no longer valid. You can request a new verification email below, but please note that excessive requests may result in temporary restrictions.</p>
    </div>

    <div class="form-container">
      <% if(error && error.length > 0) { %>
        <div class="alert-error"><%= error %></div>
      <% } else if(success && success.length > 0) { %>
        <div class="alert-success"><%= success %></div>
      <% } else { %>
        <div class="alert-error" style="display: none;"></div>
        <div class="alert-success" style="display: none;"></div>
      <% } %>

      <form action="/api/resend/verification/link" method="post" id="resendForm">
        <div class="form-group">
          <label for="email">Email Address:</label>
          <input 
            type="email" 
            name="email" 
            id="email" 
            required 
            placeholder="Enter your email address"
            autocomplete="off"
            autofocus
          >
        </div>

        <button type="submit" class="btn" id="submitBtn">
          Resend Verification Email
        </button>
        
        <div class="cooldown-notice" id="cooldownNotice">
          <!-- Cooldown timer will appear here -->
        </div>
      </form>

      <div class="security-notice">
        <strong>Security Notice:</strong> Only request resend if you haven't received a verification email within 24 hours.
      </div>
    </div>
  </div>

  <script src="/js/resend.js"></script>
</body>
</html>
