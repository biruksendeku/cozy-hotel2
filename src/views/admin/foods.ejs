<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Foods | Sally's Kitchen Admin</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin/partials/header.css">
    <link rel="stylesheet" href="/css/admin/foods.css">
    <link rel="stylesheet" href="/css/admin/partials/footer.css">
</head>
<body>
    <!-- ADMIN HEADER -->

    <%- include('../partials/admin/header.ejs') %>

  <div class="page-title-section">
    <div>
    	<h2 class="page-title">
    		<i class="fas fa-utensils"></i>
    		Manage Food Items
    	</h2>
    	<div class="breadcrumb">
    		<a href="/admin">Dashboard</a>
    		<i class="fas fa-chevron-right"></i>
    		<span> Foods </span>
    	</div>
    </div>

    <div class="header-actions">
    	<a href="/admin/create" class="btn btn-primary">
    		<i class="fas fa-plus"></i>
    		Add New Food
    	</a>
    </div>
  </div>
    
    <!-- PAGE CONTENT -->
    <main class="page-content">
        <div class="container">
            <!-- Page Header -->
            <div class="page-header">

                <!-- Stats Cards -->
                <div class="stats-cards">
                    <div class="stat-card">
                        <div class="stat-icon total">
                            <i class="fas fa-utensils"></i>
                        </div>
                        <div class="stat-info">
                            <h3>
                            <%= totalFoods %>
                            </h3>
                            <p>Total Items</p>
                        </div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-icon active">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="stat-info">
                            <h3>
                            <%= activeDishes %>
                            </h3>
                            <p>Active Items</p>
                        </div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-icon rating">
                            <i class="fas fa-star"></i>
                        </div>
                        <div class="stat-info">
                            <h3>
                            	<%= averageRating.toFixed(2) %>
                            </h3>
                            <p>Avg Rating</p>
                        </div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-icon popular">
                            <i class="fas fa-fire"></i>
                        </div>
                        <div class="stat-info">
                            <h3>
                            	<%= popularDishes %>
                            </h3>
                            <p>Popular Items</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Filters Bar -->
            <div class="filters-bar">
                <div class="filters-content">
                    
                    <!-- Search Box for Name Only -->
                    <div class="search-container mb-4" id="table">
                        <form method="GET" action="/admin/foods/#table" class="d-flex gap-2">
                            <input 
                                type="text" 
                                class="search-input"
                                name="name"
                                placeholder="Search product by name..." 
                                value="<%= searchName || '' %>"
                            >
                            <button class="search-btn" type="submit">
                                <i class="fas fa-search"></i> Search
                            </button>
                            <% if (searchName) { %>
                                <a href="/admin/foods/#table" class="clear-btn">
                                    <i class="fas fa-times"></i>
                                </a>
                            <% } %>
                        </form>
                    </div>

                </div>
            </div>

            <!-- Foods Table -->
            <div class="foods-table-container" id="foods">
                <div class="table-header">
                    <h3>
                        <i class="fas fa-list"></i>
                        Food Items List
                    </h3>
                    <div class="table-actions">
                        <button class="table-btn">
                            <i class="fas fa-file-export"></i>
                            Export
                        </button>
                        <button class="table-btn">
                            <i class="fas fa-print"></i>
                            Print
                        </button>
                    </div>
                </div>
                
                <div class="table-responsive">
                    <table class="foods-table">
                        <thead>
                            <tr>
                                <th style="width: 40px;">
                                    <!--<input type="checkbox" id="selectAll">-->
                                </th>
                                <th>Food Item</th>
                                <th>Price</th>
                                <th>Rating</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th>Updated</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
<!-- Food Items -->
			<% if(foods.length !== 0) { %>
				<% foods.forEach(f => { %>
                            <tr>
                                <td>
                                    <!--<input type="checkbox" class="food-checkbox">-->
                                    <span class="food-checkbox"></span>
                                </td>
                                <td>
                                    <div class="food-item-cell">
                                        <div class="food-image" style="border: 0.25px solid #555;">
                                          <a href="/admin/edit/<%= f._id %>">
                                            <img src="<%= f.imageUrl %>" alt="<%= f.name %>" >
                                          </a>
                                        </div>
                                        <div class="food-details">
                                            <div class="food-name">
                                            	<%= f.name %>
                                            </div>
                                            <span class="food-category">
                                            	<%= f.category %>
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td class="price-cell">
                                	$<%= f.price %>
                                </td>
                                <td>
                                    <div class="rating-cell">
                                        <div class="stars">
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star-half-alt"></i>
                                        </div>
                                        <span class="rating-value">
                                        	<%= f.rating %>
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <span class="status-badge status-active">
                                    	<%= (f.status || 'unknown').charAt(0).toUpperCase() + (f.status || 'unknown').slice(1).toLowerCase() %>
                                    </span>
                                </td>
                                <td>
                                	<%= f.createdAt.toString().split(' GMT')[0] %>
                                </td>
                                <td>
                                	<%= f.updatedAt.toString().split(' GMT')[0] %>
                                </td>
                                <td>
                                    <div class="actions-cell">
                                        <a href="/admin/edit/<%= f._id %>#updateItem" class="action-btn action-edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form action="/admin/delete/<%= f._id %>" id="deleteForm" method="post" style="display: none;"></form>
                                        <button onclick="confirmDelete()" type="submit" class="action-btn action-delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                        <a href="/admin/edit/<%= f._id %>" class="action-btn action-view">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
				<% }) %>
			<% } else { %>
				<br> <h3 style="margin-left: 20px;"> No foods <!--<span style="color: tomato;"><%= //searchName %>--></span> yet. </h3> <br>
			<% } %>
                            
                            <!-- Add more food items as needed -->
                        </tbody>
                    </table>
                </div>

                <!-- Bulk Actions -->
                <div class="bulk-actions"></div>

                <!-- Pagination Component -->
                <% if (foods.length !== 0) { %>
                
                <div class="pagination mt-4 d-flex justify-content-center">
                    <!-- Previous Button -->
                    <% if (currentPage > 1) { %>
                        <a href="?page=<%= currentPage - 1 %>/#table" class="btn btn-outline-primary mx-1">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    <% } else { %>
                        <button class="btn btn-outline-secondary mx-1 disabled">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                    <% } %>
                
                    <!-- Page Numbers -->
                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <% if (i === currentPage) { %>
                            <button class="btn btn-primary mx-1 active"><%= i %></button>
                        <% } else if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) { %>
                            <a href="?page=<%= i %>/#table" class="btn btn-outline-primary mx-1"><%= i %></a>
                        <% } else if (i === currentPage - 3 || i === currentPage + 3) { %>
                            <span class="mx-1 align-self-center">...</span>
                        <% } %>
                    <% } %>
                
                    <!-- Next Button -->
                    <% if (currentPage < totalPages) { %>
                        <a href="?page=<%= currentPage + 1 %>/#table" class="btn btn-outline-primary mx-1">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    <% } else { %>
                        <button class="btn btn-outline-secondary mx-1 disabled">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    <% } %>
                </div>
                <% } else { %>
                	<div class="pagination mt-4 d-flex justify-content-center">

                		<button class="btn btn-outline-secondary mx-1 disabled">
                			<i class="fas fa-chevron-left"></i>
                		</button>
                	
                		<button class="btn btn-primary mx-1 disabled"> 1 </button>
                	
                		<button class="btn btn-outline-secondary mx-1 disabled">
                			<i class="fas fa-chevron-right"></i>
                		</button>
                	</div>
                <%} %>
                
            </div>
        </div>
    </main>

    <!-- ADMIN FOOTER -->
    <%- include('../partials/admin/footer.ejs') %>

 <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"> </script>
 <script src="/js/admin/foods.js"></script>
</body>
</html>
