<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>How It Works | Hotel Transylvania</title>
    
    <!-- Font Awesome & Google Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary: #b89c4a;
            --primary-dark: #b89c4a;
            --secondary: #7a1f1f;
            --tertiary: #7a1f1f;
            --dark: #1a1a1a;
            --light: #F9F9F9;
            --gray: #636E72;
            --gray-light: #DFE6E9;
            --white: #FFFFFF;
            --shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            --radius: 16px;
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            color: var(--dark);
            line-height: 1.6;
        }

        /* Header Styles (Copy your existing header CSS here) */
        .header {
            position: sticky;
            top: 0;
            z-index: 1002;
            background: #1c1c1c;
            box-shadow: 0 10px 30px rgba(50, 50, 50, 0.45);
        }
        
        .header-container {
            background: transparent;
            backdrop-filter: blur(5px);
            display: flex;
            flex-flow: row nowrap;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            padding: 20px;
        }
        
        .header-logo > a {
            color: var(--primary-dark);
            font-style: normal;
            display: flex;
            flex-flow: row nowrap;
            justify-content: center;
            align-items: center;
            gap: 5px;
            text-decoration: none;
            transition: all 0.5s ease;
        }
        
        .header-logo > a:hover {
            transform: scale(1.01);
        }
        
        .logo-container {
            border: 1px solid var(--primary);
            border-radius: 8px;
            padding: 12px;
        }
        
        .logo-container > i {
            font-size: 22px;
        }
        
        .logo-name {
            display: flex;
            flex-flow: column;
            justify-content: center;
            align-items: flex-start;
            gap: 0;
        }
        
        .logo-name > h1 {
            font-size: 1.3rem;
            font-weight: 500;
            color: var(--white);
        }
        
        .logo-name > p {
            font-size: 0.9rem;
            font-weight: 400;
            color: var(--white);
        }
        
        .link-container {
            display: flex;
            flex-flow: row nowrap;
            justify-content: center;
            align-items: center;
            gap: 30px;
        }
        
        .header-links > a {
            color: var(--white);
            font-size: 1.1rem;
            font-weight: 500;
            text-decoration: none;
            display: flex;
            flex-flow: row nowrap;
            justify-content: center;
            align-items: center;
            gap: 5px;
            transition: all 0.3s ease;
        }
        
        .header-links > a:hover {
            border-bottom: 1px solid var(--primary);
        }
        
        .header-links > a > i {
            font-size: 15px;
            font-weight: light;
            color: #bbbbbb;
        }
        
        .header-link5 > a {
            font-size: 17px;
            font-weight: light;
            color: #bbbbbb;
        }
        
        .header-link1 > a {
            color: var(--primary);
        }
        
        .header-link1 > a > i {
            color: var(--primary);
        }
        
        .header-link5 > a:hover {
            border: none;
            color: var(--primary);
            transform: scale(1.1);
        }
        
        .header-links > a > span {
            font-weight: 350;
        }
        
        .carted-items {
            padding: 15px;
            position: relative;
        }
        
        #cartLenShow {
            position: absolute;
            top: 0;
            right: 0;
            background: var(--primary);
            color: var(--white);
            border-radius: 50%;
            padding: 0 6px;
            font-size: 13px;
            font-weight: 600;
            text-align: center;
        }

        /* Main Content */
        .main-container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
        }

        /* Hero Section */
        .guide-hero {
            background: linear-gradient(135deg, var(--secondary), var(--tertiary));
            border-radius: var(--radius);
            padding: 60px 40px;
            margin-bottom: 50px;
            color: var(--white);
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow);
        }

        .guide-hero::before {
            content: '🦇';
            position: absolute;
            right: 20px;
            bottom: 20px;
            font-size: 120px;
            opacity: 0.1;
        }

        .guide-hero h1 {
            font-size: 42px;
            font-weight: 700;
            margin-bottom: 15px;
            position: relative;
            z-index: 1;
        }

        .guide-hero p {
            font-size: 18px;
            max-width: 600px;
            opacity: 0.9;
            position: relative;
            z-index: 1;
        }

        /* Steps Grid */
        .steps-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
            margin-bottom: 60px;
        }

        .step-card {
            background: var(--white);
            border-radius: var(--radius);
            padding: 30px;
            box-shadow: var(--shadow);
            transition: var(--transition);
            position: relative;
            border: 1px solid var(--gray-light);
        }

        .step-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            border-color: var(--primary);
        }

        .step-number {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: 700;
            color: var(--white);
            margin-bottom: 20px;
        }

        .step-card i {
            font-size: 40px;
            color: var(--primary);
            margin-bottom: 20px;
        }

        .step-card h3 {
            font-size: 22px;
            color: var(--dark);
            margin-bottom: 15px;
        }

        .step-card p {
            color: var(--gray);
            margin-bottom: 20px;
        }

        .step-tip {
            background: var(--light);
            padding: 10px 15px;
            border-radius: 8px;
            font-size: 14px;
            color: var(--gray);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .step-tip i {
            font-size: 16px;
            margin: 0;
            color: var(--primary);
        }

        /* Features Section */
        .features-section {
            margin-bottom: 60px;
        }

        .section-title {
            text-align: center;
            margin-bottom: 40px;
        }

        .section-title h2 {
            font-size: 32px;
            color: var(--dark);
            margin-bottom: 15px;
        }

        .section-title p {
            color: var(--gray);
            max-width: 600px;
            margin: 0 auto;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 25px;
        }

        .feature-item {
            background: var(--white);
            border-radius: var(--radius);
            padding: 25px;
            text-align: center;
            box-shadow: var(--shadow);
            border: 1px solid var(--gray-light);
            transition: var(--transition);
        }

        .feature-item:hover {
            transform: translateY(-3px);
            border-color: var(--primary);
        }

        .feature-item i {
            font-size: 40px;
            color: var(--primary);
            margin-bottom: 15px;
        }

        .feature-item h4 {
            font-size: 18px;
            color: var(--dark);
            margin-bottom: 10px;
        }

        .feature-item p {
            font-size: 14px;
            color: var(--gray);
        }

        /* FAQ Section */
        .faq-section {
            background: var(--white);
            border-radius: var(--radius);
            padding: 40px;
            box-shadow: var(--shadow);
            margin-bottom: 60px;
        }

        .faq-item {
            border-bottom: 1px solid var(--gray-light);
            margin-bottom: 20px;
            padding-bottom: 20px;
        }

        .faq-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .faq-question {
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            padding: 10px 0;
        }

        .faq-question h4 {
            font-size: 18px;
            color: var(--dark);
            font-weight: 600;
        }

        .faq-question i {
            color: var(--primary);
            transition: var(--transition);
        }

        .faq-answer {
            display: none;
            padding: 15px 0 10px;
            color: var(--gray);
        }

        .faq-item.active .faq-answer {
            display: block;
        }

        .faq-item.active .faq-question i {
            transform: rotate(180deg);
        }

        /* Video Tutorial */
        .video-tutorial {
            background: linear-gradient(135deg, var(--secondary), var(--tertiary));
            border-radius: var(--radius);
            padding: 40px;
            color: var(--white);
            text-align: center;
            margin-bottom: 40px;
        }

        .video-tutorial h3 {
            font-size: 24px;
            margin-bottom: 20px;
        }

        .video-placeholder {
            background: rgba(255,255,255,0.1);
            border-radius: 12px;
            padding: 60px;
            cursor: pointer;
            transition: var(--transition);
            border: 2px dashed rgba(255,255,255,0.3);
        }

        .video-placeholder:hover {
            background: rgba(255,255,255,0.2);
            transform: scale(1.02);
        }

        .video-placeholder i {
            font-size: 60px;
            margin-bottom: 15px;
        }

        .video-placeholder p {
            font-size: 18px;
        }

        /* Contact Support */
        .support-section {
            text-align: center;
            padding: 40px;
            background: var(--light);
            border-radius: var(--radius);
        }

        .support-section h3 {
            font-size: 24px;
            color: var(--dark);
            margin-bottom: 15px;
        }

        .support-section p {
            color: var(--gray);
            margin-bottom: 30px;
        }

        .support-buttons {
            display: flex;
            gap: 20px;
            justify-content: center;
        }

        .btn {
            padding: 15px 30px;
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: var(--white);
            border: none;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(184, 156, 74, 0.3);
        }

        .btn-secondary {
            background: var(--white);
            color: var(--gray);
            border: 2px solid var(--gray-light);
        }

        .btn-secondary:hover {
            border-color: var(--primary);
            color: var(--primary);
        }

        /* Responsive */
        @media (max-width: 768px) {
            .header-container {
                flex-flow: column;
                justify-content: center;
            }

            .guide-hero h1 {
                font-size: 32px;
            }

            .guide-hero p {
                font-size: 16px;
            }

            .support-buttons {
                flex-direction: column;
            }

            .faq-section {
                padding: 20px;
            }
        }

        /* Footer */
        .footer {
            background: var(--dark);
            color: var(--white);
            padding: 40px 0;
            margin-top: 60px;
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .footer-links {
            display: flex;
            gap: 20px;
        }

        .footer-links a {
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            transition: var(--transition);
        }

        .footer-links a:hover {
            color: var(--primary);
        }
    </style>
</head>
<body>
    <!-- Header (Copy your existing header here) -->
    <header class="header">
        <div class="header-container">
            <div class="header-logo">
                <a href="/">
                    <div class="logo-container">
                        <i class="fas fa-utensils"></i>
                    </div>
                    <div class="logo-name">
                        <h1>Hotel Transylvania</h1>
                        <p>Warm Welcome Guests!</p>
                    </div>
                </a>
            </div>
            <div class="link-container">
                <div class="header-links header-link1">
                    <a href="/">
                        <i class="fas fa-home"></i>
                        <span>Home</span>
                    </a>
                </div>
                <div class="header-links header-link2">
                    <a href="/menu">
                        <i class="fas fa-utensils"></i>
                        <span>Menu</span>
                    </a>
                </div>
                <div class="header-links header-link3">
                    <a href="/delivery">
                        <i class="fas fa-truck"></i>
                        <span>Delivery</span>
                    </a>
                </div>
                <div class="header-links header-link4">
                    <a href="/contact">
                        <i class="fas fa-phone"></i>
                        <span>Contact</span>
                    </a>
                </div>
                <div class="header-links header-link5">
                    <a href="/cart">
                        <span class="carted-items">
                            <i class="fas fa-shopping-cart"></i>
                            <span id="cartLenShow">0</span>
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <div class="main-container">
        <!-- Hero Section -->
        <div class="guide-hero">
            <h1>🦇 How It Works</h1>
            <p>Welcome to Hotel Transylvania! Here's everything you need to know about ordering from our spooky kitchen.</p>
        </div>

        <!-- Steps Grid -->
        <h2 style="text-align: center; margin-bottom: 30px;">Simple 4-Step Process</h2>
        <div class="steps-grid">
            <div class="step-card">
                <div class="step-number">1</div>
                <i class="fas fa-utensils"></i>
                <h3>Browse Menu</h3>
                <p>Explore our delicious Transylvanian-inspired dishes. From Dracula's favorite steak to Mavis's vegetarian delights.</p>
                <div class="step-tip">
                    <i class="fas fa-lightbulb"></i>
                    <span>Pro tip: Check out our "Popular Items" section!</span>
                </div>
            </div>

            <div class="step-card">
                <div class="step-number">2</div>
                <i class="fas fa-cart-plus"></i>
                <h3>Add to Cart</h3>
                <p>Select items and quantities. Watch your cart grow as you add more spooky treats!</p>
                <div class="step-tip">
                    <i class="fas fa-lightbulb"></i>
                    <span>Minimum order quantity is 1 item</span>
                </div>
            </div>

            <div class="step-card">
                <div class="step-number">3</div>
                <i class="fas fa-credit-card"></i>
                <h3>Checkout</h3>
                <p>Review your order, add delivery details, and choose payment method.</p>
                <div class="step-tip">
                    <i class="fas fa-lightbulb"></i>
                    <span>Free delivery on orders over $50!</span>
                </div>
            </div>

            <div class="step-card">
                <div class="step-number">4</div>
                <i class="fas fa-truck"></i>
                <h3>Get Delivery</h3>
                <p>Track your order in real-time. Our bats deliver faster than you can say "Transylvania"!</p>
                <div class="step-tip">
                    <i class="fas fa-lightbulb"></i>
                    <span>Average delivery time: 30-45 minutes</span>
                </div>
            </div>
        </div>

        <!-- Features Section -->
        <div class="features-section">
            <div class="section-title">
                <h2>✨ Special Features</h2>
                <p>Why thousands of ghosts and humans love ordering from us</p>
            </div>
            <div class="features-grid">
                <div class="feature-item">
                    <i class="fas fa-bolt"></i>
                    <h4>Lightning Fast</h4>
                    <p>Orders processed in under 60 seconds</p>
                </div>
                <div class="feature-item">
                    <i class="fas fa-shield-alt"></i>
                    <h4>Secure Payment</h4>
                    <p>Your card details are always safe</p>
                </div>
                <div class="feature-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <h4>Live Tracking</h4>
                    <p>Watch your order travel to you</p>
                </div>
                <div class="feature-item">
                    <i class="fas fa-headset"></i>
                    <h4>24/7 Support</h4>
                    <p>We're always here to help</p>
                </div>
            </div>
        </div>

        <!-- FAQ Section -->
        <div class="faq-section">
            <h2 style="text-align: center; margin-bottom: 30px;">❓ Frequently Asked Questions</h2>
            
            <div class="faq-item active">
                <div class="faq-question" onclick="toggleFaq(this)">
                    <h4>How do I modify my order after placing it?</h4>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p>You can modify your order within 5 minutes of placing it. Go to "My Orders" and click "Modify" next to your recent order. After 5 minutes, please contact our support team.</p>
                </div>
            </div>

            <div class="faq-item">
                <div class="faq-question" onclick="toggleFaq(this)">
                    <h4>What payment methods do you accept?</h4>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p>We accept all major credit cards (Visa, MasterCard, American Express), PayPal, and cash on delivery. All payments are securely processed.</p>
                </div>
            </div>

            <div class="faq-item">
                <div class="faq-question" onclick="toggleFaq(this)">
                    <h4>How long does delivery take?</h4>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p>Standard delivery takes 30-45 minutes. Express delivery (available in select areas) takes 15-20 minutes. You'll receive real-time updates via SMS.</p>
                </div>
            </div>

            <div class="faq-item">
                <div class="faq-question" onclick="toggleFaq(this)">
                    <h4>Can I order for someone else?</h4>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p>Absolutely! Just enter their delivery address during checkout and add any special instructions. You can also add a gift message!</p>
                </div>
            </div>

            <div class="faq-item">
                <div class="faq-question" onclick="toggleFaq(this)">
                    <h4>What's your cancellation policy?</h4>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p>You can cancel within 5 minutes of ordering for free. After that, cancellation fees may apply based on preparation status.</p>
                </div>
            </div>
        </div>

        <!-- Video Tutorial -->
        <div class="video-tutorial">
            <h3>🎥 Watch How It Works</h3>
            <div class="video-placeholder" onclick="alert('Video tutorial coming soon! Our bats are editing it 🦇')">
                <i class="fas fa-play-circle"></i>
                <p>Click to watch tutorial</p>
            </div>
        </div>

        <!-- Support Section -->
        <div class="support-section">
            <h3>Need Help?</h3>
            <p>Our support team is available 24/7 to assist you with any questions</p>
            <div class="support-buttons">
                <a href="/contact" class="btn btn-primary">
                    <i class="fas fa-envelope"></i>
                    Contact Support
                </a>
                <a href="/faq" class="btn btn-secondary">
                    <i class="fas fa-question-circle"></i>
                    View Full FAQ
                </a>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-content">
            <div>© 2024 Hotel Transylvania. All rights reserved.</div>
            <div class="footer-links">
                <a href="/terms">Terms</a>
                <a href="/privacy">Privacy</a>
                <a href="/contact">Contact</a>
            </div>
        </div>
    </footer>

    <script>
        // FAQ Toggle
        function toggleFaq(element) {
            const faqItem = element.parentElement;
            faqItem.classList.toggle('active');
        }

        // Update cart count from localStorage or session
        function updateCartCount() {
            const cartSpan = document.getElementById('cartLenShow');
            if (cartSpan) {
                // You can get this from your backend or localStorage
                const cartCount = <%= cart?.length || 0 %>;
                cartSpan.textContent = cartCount;
            }
        }

        // Auto-hide notifications if any
        document.addEventListener('DOMContentLoaded', function() {
            updateCartCount();
            
            // Auto-hide success/error messages after 5 seconds
            const messages = document.querySelectorAll('.message');
            messages.forEach(msg => {
                setTimeout(() => {
                    msg.style.opacity = '0';
                    setTimeout(() => msg.remove(), 300);
                }, 5000);
            });
        });
    </script>
</body>
</html>
